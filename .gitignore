# Build output
build/work/
dist/
*.spec.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Language packs and generated packs must never be committed: they are
# Dassault Systemes files, several hundred megabytes each. The patterns are
# anchored to the root so that the synthetic sample pack, which contains no
# SOLIDWORKS material, is still tracked.
*.chm
*.xaml
/english/
/english_*/
/chinese/
/chinese_*/
*.backup-*/
/out/

*.dll
!samples/**/*.dll

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local logs
swbilingual-log*.txt
